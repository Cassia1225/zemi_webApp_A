# このファイルをコピーして .env を作る（.env はGitに入れない）

# Neonの接続文字列
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# メール内のリンクに使うURL
APP_URL=http://localhost:8000

# local または production（productionではCookieをHTTPS限定にする）
APP_ENV=local

# log: storage/mail.log に書き出す / resend: Resendで実際に送る
MAIL_DRIVER=log
MAIL_FROM=
RESEND_API_KEY=
